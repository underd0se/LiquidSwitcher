<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.TVAppSwitcher" parent="Theme.MaterialComponents.NoActionBar">
        <item name="colorPrimary">@color/accent_primary</item>
        <item name="colorPrimaryVariant">@color/accent_primary_variant</item>
        <item name="colorOnPrimary">#000000</item>
        <item name="colorSecondary">@color/accent_primary</item>
        <item name="colorSecondaryVariant">@color/accent_primary_variant</item>
        <item name="colorOnSecondary">#000000</item>
        <item name="android:statusBarColor">@color/bg_root</item>
        <item name="android:colorBackground">@color/bg_root</item>
        <item name="colorSurface">@color/surface_card</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="alertDialogTheme">@style/Theme.TVAppSwitcher.Dialog</item>
        <item name="materialAlertDialogTheme">@style/Theme.TVAppSwitcher.Dialog</item>
    </style>

    <style name="Theme.TVAppSwitcher.Dialog" parent="Theme.MaterialComponents.Dialog.Alert">
        <item name="android:background">@color/surface_card</item>
        <item name="android:windowBackground">@color/surface_card</item>
        <item name="colorSurface">@color/surface_card</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:textColorAlertDialogListItem">@color/text_primary</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:editTextColor">@color/text_primary</item>
        <item name="colorPrimary">@color/accent_primary</item>
        <item name="colorSecondary">@color/accent_primary</item>
        <item name="android:textAppearanceListItem">@style/Theme.TVAppSwitcher.Dialog.TextAppearanceListItem</item>
        <item name="android:textAppearanceListItemSmall">@style/Theme.TVAppSwitcher.Dialog.TextAppearanceListItem</item>
        <item name="buttonBarPositiveButtonStyle">@style/Theme.TVAppSwitcher.Dialog.Button</item>
        <item name="buttonBarNegativeButtonStyle">@style/Theme.TVAppSwitcher.Dialog.Button</item>
        <item name="buttonBarNeutralButtonStyle">@style/Theme.TVAppSwitcher.Dialog.Button</item>
        <item name="materialAlertDialogTitleTextStyle">@style/Theme.TVAppSwitcher.Dialog.Title</item>
        <item name="materialAlertDialogBodyTextStyle">@style/Theme.TVAppSwitcher.Dialog.Body</item>
    </style>

    <style name="Theme.TVAppSwitcher.Dialog.Title" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">18sp</item>
    </style>

    <style name="Theme.TVAppSwitcher.Dialog.Body" parent="TextAppearance.MaterialComponents.Body1">
        <item name="android:textColor">#E2E4F0</item>
        <item name="android:textSize">15sp</item>
        <item name="android:lineSpacingExtra">3dp</item>
    </style>

    <style name="Theme.TVAppSwitcher.Dialog.TextAppearanceListItem" parent="TextAppearance.AppCompat.Subhead">
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="Theme.TVAppSwitcher.Dialog.Button" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:textColor">#00E5FF</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">15sp</item>
    </style>

    <!-- macOS Dock Squircle Icon Shape (22% corner radius) -->
    <style name="ShapeAppearance.MacDockIcon" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">22%</item>
    </style>
</resources>
