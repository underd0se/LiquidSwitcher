<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/llOverlayRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center_horizontal|bottom"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:paddingStart="32dp"
    android:paddingEnd="32dp"
    android:paddingTop="24dp"
    android:paddingBottom="24dp">

    <!-- Floating Dock Tooltip for the active app name & countdown -->
    <LinearLayout
        android:id="@+id/llDockTooltipContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:background="@drawable/bg_dock_tooltip"
        android:elevation="20dp"
        android:visibility="invisible">

        <TextView
            android:id="@+id/tvDockTooltip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />

        <View
            android:id="@+id/vDockCountdown"
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:layout_marginTop="5dp"
            android:background="@drawable/bg_dock_countdown"
            android:visibility="gone" />

    </LinearLayout>

    <!-- Translucent Liquid Dock Pill Container -->
    <com.baris.tvappswitcher.LiquidDockView
        android:id="@+id/flDockPill"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingStart="28dp"
        android:paddingEnd="28dp"
        android:paddingTop="12dp"
        android:paddingBottom="10dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:elevation="24dp">

        <HorizontalScrollView
            android:id="@+id/hsvOverlay"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:overScrollMode="never"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:clipChildren="false"
            android:clipToPadding="false">

            <LinearLayout
                android:id="@+id/llOverlayApps"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical|bottom"
                android:clipChildren="false"
                android:clipToPadding="false" />

        </HorizontalScrollView>
    </com.baris.tvappswitcher.LiquidDockView>

    <!-- Empty State View - shown when no apps are available -->
    <LinearLayout
        android:id="@+id/llEmptyState"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:visibility="gone"
        android:padding="24dp">

        <ImageView
            android:id="@+id/ivEmptyStateIcon"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:src="@drawable/ic_launcher"
            android:alpha="0.5" />

        <TextView
            android:id="@+id/tvEmptyStateTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/no_apps_in_switcher"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvEmptyStateMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/empty_state_message"
            android:textColor="#AAFFFFFF"
            android:textSize="13sp"
            android:gravity="center" />

    </LinearLayout>

</LinearLayout>
