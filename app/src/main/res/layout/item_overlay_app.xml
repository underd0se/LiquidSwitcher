<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/llItemRoot"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center_horizontal|bottom"
    android:paddingStart="8dp"
    android:paddingEnd="8dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:focusable="false">

    <!-- Icon container with squircle outline and zero border -->
    <FrameLayout
        android:id="@+id/flIconContainer"
        android:layout_width="66dp"
        android:layout_height="66dp"
        android:background="@drawable/bg_dock_icon_plate"
        android:clipChildren="false"
        android:clipToPadding="false">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/ivOverlayAppIcon"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitCenter"
            android:adjustViewBounds="true"
            android:alpha="1.0"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.MacDockIcon"
            android:importantForAccessibility="no" />
    </FrameLayout>

</LinearLayout>
