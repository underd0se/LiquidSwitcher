<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/llReorderRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="10dp"
    android:layout_marginBottom="6dp"
    android:background="@drawable/selector_app_list_item"
    android:focusable="true"
    android:clickable="true"
    android:gravity="center_vertical">

    <TextView
        android:id="@+id/tvOrderRank"
        android:layout_width="38dp"
        android:layout_height="wrap_content"
        android:text="#1"
        android:textColor="@color/accent_primary"
        android:fontFeatureSettings="tnum"
        android:textSize="16sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginEnd="8dp" />

    <ImageView
        android:id="@+id/ivReorderAppIcon"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginEnd="14dp" />

    <TextView
        android:id="@+id/tvReorderAppName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@color/text_primary" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnMoveUp"
        android:layout_width="48dp"
        android:layout_height="40dp"
        android:text="▲"
        android:textColor="@color/selector_tv_btn_text"
        android:background="@drawable/selector_tv_btn_bg"
        android:textSize="16sp"
        android:textStyle="bold"
        android:focusable="true"
        android:clickable="true"
        android:layout_marginEnd="8dp" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnMoveDown"
        android:layout_width="48dp"
        android:layout_height="40dp"
        android:text="▼"
        android:textColor="@color/selector_tv_btn_text"
        android:background="@drawable/selector_tv_btn_bg"
        android:textSize="16sp"
        android:textStyle="bold"
        android:focusable="true"
        android:clickable="true" />

</LinearLayout>
