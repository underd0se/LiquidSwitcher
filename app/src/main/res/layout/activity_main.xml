<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_root"
    android:paddingStart="24dp"
    android:paddingEnd="24dp"
    android:paddingTop="20dp"
    android:paddingBottom="20dp">

    <!-- App Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="20dp">

        <ImageView
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:src="@drawable/ic_launcher" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:text="@string/app_name"
            android:textColor="@color/text_primary"
            android:textSize="22sp"
            android:fontFamily="sans-serif-medium" />

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <LinearLayout
            android:id="@+id/tvServiceStatus"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_status_pill"
            android:paddingStart="16dp"
            android:paddingEnd="18dp"
            android:clickable="true"
            android:focusable="true">

            <View
                android:id="@+id/serviceStatusDot"
                android:layout_width="9dp"
                android:layout_height="9dp"
                android:layout_marginEnd="10dp"
                android:background="@drawable/bg_status_dot_on" />

            <TextView
                android:id="@+id/tvServiceStatusLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/service_status_active"
                android:textColor="@color/text_secondary"
                android:textSize="14sp"
                android:fontFamily="sans-serif-medium" />

        </LinearLayout>

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <!-- Navigation Rail -->
        <LinearLayout
            android:layout_width="220dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_settings_card"
            android:padding="10dp"
            android:clipChildren="false"
            android:clipToPadding="false">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="10dp"
                android:letterSpacing="0.12"
                android:text="@string/settings_rail_label"
                android:textAllCaps="true"
                android:textColor="@color/text_muted"
                android:textSize="11sp"
                android:fontFamily="sans-serif-medium" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/tabSwitching"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/bg_settings_tab"
                android:text="@string/tab_switching"
                android:textAllCaps="false"
                android:textColor="@color/selector_settings_tab_text"
                android:textSize="16sp"
                android:gravity="start|center_vertical"
                android:paddingStart="20dp"
                android:paddingEnd="12dp"
                android:focusable="true"
                android:stateListAnimator="@null" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/tabApps"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_settings_tab"
                android:text="@string/tab_apps"
                android:textAllCaps="false"
                android:textColor="@color/selector_settings_tab_text"
                android:textSize="16sp"
                android:gravity="start|center_vertical"
                android:paddingStart="20dp"
                android:paddingEnd="12dp"
                android:focusable="true"
                android:stateListAnimator="@null" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/tabDockSizing"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_settings_tab"
                android:text="@string/tab_dock_sizing"
                android:textAllCaps="false"
                android:textColor="@color/selector_settings_tab_text"
                android:textSize="16sp"
                android:gravity="start|center_vertical"
                android:paddingStart="20dp"
                android:paddingEnd="12dp"
                android:focusable="true"
                android:stateListAnimator="@null" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/tabDockAppearance"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_settings_tab"
                android:text="@string/tab_dock_appearance"
                android:textAllCaps="false"
                android:textColor="@color/selector_settings_tab_text"
                android:textSize="16sp"
                android:gravity="start|center_vertical"
                android:paddingStart="20dp"
                android:paddingEnd="12dp"
                android:focusable="true"
                android:stateListAnimator="@null" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/tabShortcuts"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_settings_tab"
                android:text="@string/tab_shortcuts"
                android:textAllCaps="false"
                android:textColor="@color/selector_settings_tab_text"
                android:textSize="16sp"
                android:gravity="start|center_vertical"
                android:paddingStart="20dp"
                android:paddingEnd="12dp"
                android:focusable="true"
                android:stateListAnimator="@null" />

        </LinearLayout>

        <!-- Content Pane -->
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="20dp"
            android:clipChildren="false"
            android:clipToPadding="false">

            <ScrollView
                android:id="@+id/settingsScroll"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:scrollbars="none">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="4dp"
                    android:paddingBottom="24dp">

                    <androidx.constraintlayout.widget.Guideline
                        android:id="@+id/paneCenter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        app:layout_constraintGuide_percent="0.5" />

                    <FrameLayout
                        android:id="@+id/paneHost"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        app:layout_constraintWidth_max="980dp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintHorizontal_bias="0.5">

                        <include
                            android:id="@+id/paneSwitching"
                            layout="@layout/pane_switching"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content" />

                        <include
                            android:id="@+id/paneApps"
                            layout="@layout/pane_apps"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:visibility="gone" />

                        <include
                            android:id="@+id/paneDockSizing"
                            layout="@layout/pane_dock_sizing"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:visibility="gone" />

                        <include
                            android:id="@+id/paneDockAppearance"
                            layout="@layout/pane_dock_appearance"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:visibility="gone" />

                        <include
                            android:id="@+id/paneShortcuts"
                            layout="@layout/pane_shortcuts"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:visibility="gone"
                            tools:visibility="visible" />

                    </FrameLayout>

                </androidx.constraintlayout.widget.ConstraintLayout>

            </ScrollView>

        </FrameLayout>

    </LinearLayout>

</LinearLayout>