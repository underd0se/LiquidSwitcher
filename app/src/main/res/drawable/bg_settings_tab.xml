<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Focused + selected: raised fill with the accent edge marker, no outline -->
    <item android:state_focused="true" android:state_selected="true" android:state_window_focused="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="12dp" />
                    <solid android:color="@color/surface_card_elevated" />
                </shape>
            </item>
            <item android:width="3dp" android:gravity="start">
                <shape android:shape="rectangle">
                    <corners android:radius="2dp" />
                    <solid android:color="@color/accent_primary" />
                </shape>
            </item>
        </layer-list>
    </item>

    <!-- Selected, not focused -->
    <item android:state_selected="true" android:state_window_focused="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="12dp" />
                    <solid android:color="@color/surface_card_elevated" />
                </shape>
            </item>
            <item android:width="3dp" android:gravity="start">
                <shape android:shape="rectangle">
                    <corners android:radius="2dp" />
                    <solid android:color="@color/accent_primary" />
                </shape>
            </item>
        </layer-list>
    </item>

    <!-- Focused, not selected: subtle lift only, edge marker carries the affordance -->
    <item android:state_focused="true" android:state_window_focused="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="12dp" />
                    <solid android:color="@color/surface_hover" />
                </shape>
            </item>
            <item android:width="3dp" android:gravity="start">
                <shape android:shape="rectangle">
                    <corners android:radius="2dp" />
                    <solid android:color="@color/accent_primary" />
                </shape>
            </item>
        </layer-list>
    </item>

    <item>
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>
</selector>