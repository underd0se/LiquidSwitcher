<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Focused item by D-pad remote navigation -->
    <item android:state_focused="true" android:state_window_focused="true">
        <inset
            android:insetLeft="8dp"
            android:insetRight="8dp"
            android:insetTop="2dp"
            android:insetBottom="2dp">
            <shape android:shape="rectangle">
                <corners android:radius="10dp" />
                <solid android:color="#2E2E44" />
                <stroke android:width="2dp" android:color="@color/accent_primary" />
            </shape>
        </inset>
    </item>

    <!-- Selected item in ListView -->
    <item android:state_selected="true" android:state_window_focused="true">
        <inset
            android:insetLeft="8dp"
            android:insetRight="8dp"
            android:insetTop="2dp"
            android:insetBottom="2dp">
            <shape android:shape="rectangle">
                <corners android:radius="10dp" />
                <solid android:color="#2E2E44" />
                <stroke android:width="2dp" android:color="@color/accent_primary" />
            </shape>
        </inset>
    </item>

    <!-- Pressed / Clicked -->
    <item android:state_pressed="true" android:state_window_focused="true">
        <inset
            android:insetLeft="8dp"
            android:insetRight="8dp"
            android:insetTop="2dp"
            android:insetBottom="2dp">
            <shape android:shape="rectangle">
                <corners android:radius="10dp" />
                <solid android:color="#3D3D5C" />
                <stroke android:width="2dp" android:color="@color/accent_primary" />
            </shape>
        </inset>
    </item>

    <!-- Default Idle State (including checked options when not focused): transparent! -->
    <item>
        <color android:color="@android:color/transparent" />
    </item>
</selector>
