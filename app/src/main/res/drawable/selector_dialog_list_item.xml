<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Focused item by D-pad remote navigation -->
    <item android:state_focused="true">
        <inset
            android:insetLeft="10dp"
            android:insetRight="10dp"
            android:insetTop="3dp"
            android:insetBottom="3dp">
            <shape android:shape="rectangle">
                <corners android:radius="10dp" />
                <solid android:color="#2E2E44" />
                <stroke android:width="2dp" android:color="@color/accent_primary" />
            </shape>
        </inset>
    </item>

    <!-- Selected item in ListView -->
    <item android:state_selected="true">
        <inset
            android:insetLeft="10dp"
            android:insetRight="10dp"
            android:insetTop="3dp"
            android:insetBottom="3dp">
            <shape android:shape="rectangle">
                <corners android:radius="10dp" />
                <solid android:color="#2E2E44" />
                <stroke android:width="2dp" android:color="@color/accent_primary" />
            </shape>
        </inset>
    </item>

    <!-- Pressed / Clicked -->
    <item android:state_pressed="true">
        <inset
            android:insetLeft="10dp"
            android:insetRight="10dp"
            android:insetTop="3dp"
            android:insetBottom="3dp">
            <shape android:shape="rectangle">
                <corners android:radius="10dp" />
                <solid android:color="#3D3D5C" />
                <stroke android:width="2dp" android:color="@color/accent_primary" />
            </shape>
        </inset>
    </item>

    <!-- Checked / Activated (Active setting option when not actively focused) -->
    <item android:state_checked="true">
        <inset
            android:insetLeft="10dp"
            android:insetRight="10dp"
            android:insetTop="3dp"
            android:insetBottom="3dp">
            <shape android:shape="rectangle">
                <corners android:radius="10dp" />
                <solid android:color="#222232" />
                <stroke android:width="1dp" android:color="#4000E5FF" />
            </shape>
        </inset>
    </item>

    <item android:state_activated="true">
        <inset
            android:insetLeft="10dp"
            android:insetRight="10dp"
            android:insetTop="3dp"
            android:insetBottom="3dp">
            <shape android:shape="rectangle">
                <corners android:radius="10dp" />
                <solid android:color="#222232" />
                <stroke android:width="1dp" android:color="#4000E5FF" />
            </shape>
        </inset>
    </item>

    <!-- Default Idle State -->
    <item>
        <color android:color="@android:color/transparent" />
    </item>
</selector>
