<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true" android:state_window_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="100dp" />
            <solid android:color="@color/surface_hover" />
            <stroke android:width="1.5dp" android:color="@color/accent_primary" />
        </shape>
    </item>

    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="100dp" />
            <solid android:color="@color/surface_hover" />
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <corners android:radius="100dp" />
            <solid android:color="@color/surface_rail" />
            <stroke android:width="1dp" android:color="@color/surface_card_border" />
        </shape>
    </item>
</selector>