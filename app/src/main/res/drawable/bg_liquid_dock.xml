<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Outer glass rim reflection and translucent frosted glass body -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="32dp" />
            <stroke android:width="1.5dp" android:color="#55FFFFFF" />
            <solid android:color="#80151724" />
        </shape>
    </item>

    <!-- Inner specular gloss highlight at the top edge -->
    <item
        android:top="1.5dp"
        android:left="1.5dp"
        android:right="1.5dp"
        android:bottom="1.5dp">
        <shape android:shape="rectangle">
            <corners android:radius="30.5dp" />
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="#30FFFFFF"
                android:centerColor="#08FFFFFF"
                android:endColor="#00FFFFFF" />
        </shape>
    </item>
</layer-list>
